\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces 法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果；(c) 使用从点云估计的法向量得到的检测结果。可以看出，使用点云估计的法向量会导致更多的边缘点被误分类为角点。}}{29}{figure.caption.27}\protected@file@percent }
\newlabel{fig:limitation}{{3.2}{29}{法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果；(c) 使用从点云估计的法向量得到的检测结果。可以看出，使用点云估计的法向量会导致更多的边缘点被误分类为角点。}{figure.caption.27}{}}
\newlabel{fig:limitation@cref}{{[figure][2][3]3.2}{[1][29][]29}{}{}{}}
