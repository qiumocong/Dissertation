\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces 法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果，F1 分数为 0.815；(c) 使用从点云估计的法向量得到的检测结果，F1 分数为 0.715。使用点云估计的法向量会导致更多的边缘点被误分类为角点，在图中表现为红色区域的增加。}}{37}{figure.caption.32}\protected@file@percent }
\newlabel{fig:limitation}{{3.6}{37}{法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果，F1 分数为 0.815；(c) 使用从点云估计的法向量得到的检测结果，F1 分数为 0.715。使用点云估计的法向量会导致更多的边缘点被误分类为角点，在图中表现为红色区域的增加。}{figure.caption.32}{}}
\newlabel{fig:limitation@cref}{{[figure][6][3]3.6}{[1][36][]37}}
