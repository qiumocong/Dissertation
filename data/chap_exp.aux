\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces 法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果；(c) 使用从点云估计的法向量得到的检测结果。可以看出，使用点云估计的法向量会导致更多的边缘点被误分类为角点。\relax }}{44}{figure.caption.32}\protected@file@percent }
\newlabel{fig:limitation}{{6.2}{44}{法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果；(c) 使用从点云估计的法向量得到的检测结果。可以看出，使用点云估计的法向量会导致更多的边缘点被误分类为角点。\relax }{figure.caption.32}{}}
\newlabel{fig:limitation@cref}{{[figure][2][6]6.2}{[1][43][]44}}
