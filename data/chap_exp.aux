\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces 法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果；(c) 使用从点云估计的法向量得到的检测结果。可以看出，使用点云估计的法向量会导致更多的边缘点被误分类为角点。}}{46}{figure.caption.37}\protected@file@percent }
\newlabel{fig:limitation}{{6.2}{46}{法向量估计精度对检测结果的影响分析：(a) 检测结果真值（Ground Truth）；(b) 使用从 Mesh 估计的法向量得到的检测结果；(c) 使用从点云估计的法向量得到的检测结果。可以看出，使用点云估计的法向量会导致更多的边缘点被误分类为角点。}{figure.caption.37}{}}
\newlabel{fig:limitation@cref}{{[figure][2][6]6.2}{[1][46][]46}{}{}{}}
