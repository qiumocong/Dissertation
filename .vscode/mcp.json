{
	"servers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${input:github_mcp_pat}",
				"X-MCP-Toolsets": "default,copilot_spaces"
			}
		}
	},
	"inputs": [
		{
			"id": "github_mcp_pat",
			"type": "promptString",
			"description": "GitHub Personal Access Token",
			"password": true
		}
	]
}